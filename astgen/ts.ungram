// TypeScript/JavaScript Un-Grammar.
//
// This grammar specifies the structure of the concrete syntax tree produced
// by the parser. It does not specify parsing rules (ambiguities, precedence,
// etc are out of scope).
//
// Legend:
//
//   //          -- comment
//   Name =      -- non-terminal definition
//   'ident'     -- keyword or punct token (terminal)
//   '#ident'    -- generic token (terminal)
//   '@ident'    -- literal token (terminal)
//   A B         -- sequence
//   A | B       -- alternation
//   A*          -- zero or more repetition
//   A?          -- zero or one repetition
//   (A)         -- same as A
//   label:A     -- suggested name for field of AST node
//
// Fields labeled `lhs`/`rhs`/`op`/`then_branch`/`else_branch` are excluded
// from codegen (see `manually_implemented` in astgen/src/grammar.rs) because
// a node can have several children of the *same* AST type (e.g. a
// `BinaryExpression`'s two `Expression` operands) which the generated
// `support::child`/`support::children` accessors can't tell apart by
// position alone. Those accessors are hand-written in `src/ast.rs` instead.

SourceFile =
  statements:Statement*

Statement =
  Block
| EmptyStatement
| VariableStatement
| ExpressionStatement
| IfStatement
| ReturnStatement

Block =
  '{' statements:Statement* '}'

EmptyStatement =
  ';'

VariableStatement =
  VariableDeclarationList ';'

// Note: comma separators between declarations are real tokens in the tree
// (the parser emits them) but aren't modeled in the grammar shape here —
// the minimal `lower_rule` in astgen only understands bare `X*` repetition,
// not "(',' X)*"; `declarations()` (a Cardinality::Many accessor) filters
// children by type, so the interleaved commas are simply skipped over.
VariableDeclarationList =
  ('var' | 'let' | 'const') declarations:VariableDeclaration*

VariableDeclaration =
  name:Identifier ('=' initializer:Expression)?

ExpressionStatement =
  expression:Expression ';'?

IfStatement =
  'if' '(' expression:Expression ')' then_branch:Statement ('else' else_branch:Statement)?

ReturnStatement =
  'return' expression:Expression? ';'?

Expression =
  Identifier
| Literal
| ParenthesizedExpression
| PrefixUnaryExpression
| BinaryExpression
| PropertyAccessExpression

Identifier =
  '@identifier'

ParenthesizedExpression =
  '(' expression:Expression ')'

PrefixUnaryExpression =
  op:('+' | '-' | '!' | '~' | 'typeof' | 'void' | 'delete')
  operand:Expression

BinaryExpression =
  lhs:Expression
  op:('+' | '-' | '*' | '/' | '%'
    | '<' | '>' | '<=' | '>=' | '==' | '===' | '!=' | '!=='
    | '&&' | '||'
    | 'instanceof' | 'in')
  rhs:Expression

PropertyAccessExpression =
  expression:Expression '.' name:Identifier

StringLiteral = '@string_literal'
NumericLiteral = '@numeric_literal'
BigIntLiteral = '@bigint_literal'
RegularExpressionLiteral = '@regular_expression_literal'
NoSubstitutionTemplateLiteral = '@no_substitution_template_literal'

Literal =
  StringLiteral
| NumericLiteral
| BigIntLiteral
| RegularExpressionLiteral
| NoSubstitutionTemplateLiteral
